# Copy to .env for local auth.py only. NEVER commit .env.
# In GitHub Actions, set these same names as Repository Secrets.
GOOGLE_CLIENT_ID=PASTE_YOUR_DESKTOP_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=PASTE_YOUR_DESKTOP_OAUTH_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=PASTE_FROM_AUTH_PY_AFTER_PRODUCTION_MINT
INTERVALS_API_KEY=PASTE_FROM_INTERVALS_SETTINGS_DEVELOPER
INTERVALS_ATHLETE_ID=0
DAYS_BACK=2
